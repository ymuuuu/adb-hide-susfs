id=adb-hide-susfs
name=ADB Hide (susfs)
version=v1.3.0
versionCode=7
author=ymuuuu (ADB subset ported from BRENE by rrr333nnn333)
description=Hides ADB from apps while real adb keeps working: spoofs the ADB runtime props with resetprop, gated so they never contradict a visible adbd, and hides /dev/socket/adbd and @jdwp-control through the susfs LKM fork (sus_unix layer).
updateJson=
